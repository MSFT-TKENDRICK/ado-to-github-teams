{
  "name": "ado-to-github-teams",
  "version": "0.1.0",
  "description": "Migrate Azure DevOps project teams to GitHub org teams",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "ado-to-github-teams": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "sandbox"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "cross-env VARLOCK_TELEMETRY_DISABLED=1 varlock run --inject vars -- tsx src/cli.ts",
    "worker:build": "nitro build --dir src",
    "worker:dev": "cross-env VARLOCK_TELEMETRY_DISABLED=1 varlock run --inject vars -- nitro dev --dir src",
    "test": "vitest run",
    "test:bdd": "tsx scripts/run-bdd.ts",
    "experiment:personas": "tsx scripts/run-persona-experiments.ts",
    "optimize:ux": "tsx skills/optimize-ux/scripts/optimize-ux.ts",
    "optimize:dx": "tsx skills/optimize-dx/scripts/optimize-dx.ts",
    "squad:bootstrap": "tsx scripts/bootstrap-squad.ts",
    "squad:build": "squad build",
    "squad:check": "squad build --check && tsx scripts/check-squad-init-assets.ts",
    "squad:doctor": "squad doctor",
    "squad:status": "squad status",
    "squad:copilot": "tsx scripts/run-squad.ts",
    "squad:nap": "squad nap --dry-run",
    "tui:evidence:render": "tsx scripts/render-tui-evidence.ts test/bdd/features/evidence/tui",
    "tui:evidence": "pnpm tui:evidence:render && python scripts/capture-tui-evidence.py test/bdd/features/evidence/tui",
    "test:contract": "vitest run test/contract --reporter=default --reporter=json --outputFile=reports/contract-results.json && tsx scripts/assert-contract-verified.ts reports/contract-results.json",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "package:smoke": "pnpm --dir apps/cli build && node scripts/package-smoke.mjs",
    "lint": "eslint src test scripts skills squad.config.ts --ext .ts",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"skills/**/*.ts\" \"squad.config.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"skills/**/*.ts\" \"squad.config.ts\"",
    "secrets:validate": "cross-env VARLOCK_TELEMETRY_DISABLED=1 varlock load --agent",
    "secrets:scan": "cross-env VARLOCK_TELEMETRY_DISABLED=1 varlock scan",
    "secrets:check": "pnpm secrets:validate && pnpm secrets:scan",
    "check": "pnpm secrets:check && pnpm squad:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:unit && pnpm test:contract && pnpm test:integration && pnpm package:smoke"
  },
  "oclif": {
    "bin": "ado-to-github-teams",
    "dirname": "ado-to-github-teams",
    "commands": "./dist/commands"
  },
  "dependencies": {
    "@azure/identity": "^4.4.1",
    "@azure/identity-broker": "^1.4.0",
    "@azure/identity-cache-persistence": "^1.3.0",
    "@fantasticfour/world-nats-jetstream": "1.4.0",
    "@github/copilot-sdk": "^1.0.8-preview.0",
    "@inquirer/prompts": "^7.1.0",
    "@libsql/client": "0.14.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@oclif/core": "^3.26.6",
    "@octokit/rest": "^22.0.0",
    "@workflow-worlds/turso": "0.2.2",
    "@workflow/world": "4.2.1",
    "azure-devops-node-api": "^14.1.0",
    "chalk": "^5.3.0",
    "effect": "^3.10.8",
    "express": "5.2.1",
    "nitro": "3.0.260610-beta",
    "rollup": "4.62.2",
    "varlock": "1.13.0",
    "workflow": "4.2.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@bradygaster/squad-cli": "0.11.0",
    "@bradygaster/squad-sdk": "0.11.0",
    "@cucumber/cucumber": "^12.9.0",
    "@cucumber/messages": "^32.3.1",
    "@cucumber/query": "^15.0.1",
    "@pact-foundation/pact": "^13.2.0",
    "@types/express": "5.0.6",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "cross-env": "10.1.0",
    "eslint": "^8.57.1",
    "lefthook": "2.1.10",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vscode-jsonrpc": "9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@workflow/world": "4.2.1"
    }
  },
  "engines": {
    "node": ">=22.18.0 <26"
  }
}
