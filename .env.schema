# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=false
# ---
# Selects environment-specific validation. Production requires durable worker secrets.
# @type=enum(development, test, production)
APP_ENV=development

# Durable worker authentication. Keep independent values and store local overrides encrypted.
# @sensitive @required=forEnv(production) @type=string(minLength=32)
WORKFLOW_API_TOKEN=
# @auditIgnore @sensitive @required=forEnv(production) @type=string(minLength=32)
WORKFLOW_TASK_SECRET=

# Durable worker runtime configuration.
# @auditIgnore @type=port
PORT=7331
# @type=string
WORKFLOW_SQLITE_PATH=
# @type=string
WORKFLOW_REPORT_DIR=
# @auditIgnore @type=string
WORKFLOW_NATS_URLS=
# @type=url
WORKFLOW_BASE_URL=
# @type=url
WORKFLOW_INTERNAL_BASE_URL=
# @auditIgnore @type=number(min=1, isInt=true)
WORKFLOW_NATS_CONCURRENCY=
# @auditIgnore @type=string
WORKFLOW_TARGET_WORLD=
# @auditIgnore @type=boolean
WORKFLOW_ALLOW_REMOTE_TARGET=

# Litestream configuration supplied to the worker container.
# @auditIgnore @type=string
LITESTREAM_CONFIG=
# @auditIgnore @type=string
LITESTREAM_NATS_URL=
# @auditIgnore @type=string
LITESTREAM_NATS_BUCKET=migration_backups

# Prefer workload identity, managed identity, or an existing developer login.
# @auditIgnore @type=string
AZURE_CLIENT_ID=
# @auditIgnore @type=string
AZURE_TENANT_ID=
# @auditIgnore @type=string
AZURE_FEDERATED_TOKEN_FILE=
# @auditIgnore @type=string
AZURE_CLIENT_CERTIFICATE_PATH=
# @auditIgnore @type=string
AZURE_TOKEN_CREDENTIALS=
# @auditIgnore @type=url
IDENTITY_ENDPOINT=
# @auditIgnore @type=url
MSI_ENDPOINT=

# Password and secret based Azure authentication are compatibility fallbacks.
# @auditIgnore @sensitive
AZURE_CLIENT_SECRET=
# @auditIgnore @sensitive
AZURE_CLIENT_CERTIFICATE_PASSWORD=
# @auditIgnore @sensitive
AZURE_PASSWORD=

# Legacy Entra aliases remain supported for compatibility.
# @auditIgnore @type=string
ENTRA_CLIENT_ID=
# @auditIgnore @type=string
ENTRA_PUBLIC_CLIENT_ID=
# @auditIgnore @type=string
ENTRA_TENANT_ID=
# @auditIgnore @sensitive
ENTRA_CLIENT_SECRET=

# Prefer Entra authentication for Azure DevOps; a PAT is an explicit fallback.
# @auditIgnore @sensitive
ADO_PAT=

# Prefer `gh auth login` locally and GitHub's short-lived workflow token in Actions.
# @auditIgnore @sensitive
GH_TOKEN=
# @auditIgnore @sensitive
GITHUB_TOKEN=
# @auditIgnore @sensitive
GITHUB_PAT=
# @auditIgnore @type=string
GITHUB_CLIENT_ID=
